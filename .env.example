# Kopie als .env.local anlegen und ausfüllen. Diese Datei enthält nur
# Platzhalter und ist die einzige .env-Datei, die committet wird
# (siehe .gitignore: .env.* ist ignoriert, .env.example ausgenommen).

# --- Supabase (öffentlich, landen im Client-Bundle) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (serverseitig, niemals NEXT_PUBLIC_) ---------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HUNT_SUPABASE_URL=
HUNT_SUPABASE_SERVICE_ROLE_KEY=

# --- Kick OAuth ---------------------------------------------------------------
NEXT_PUBLIC_KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
# Nur lokal: Redirect-Ziel abweichend von der Produktionsdomain.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# --- Admin-Zugang -------------------------------------------------------------
# Kommaseparierte E-Mail-Adressen mit Admin-Rechten.
ADMIN_EMAILS=
# Optionale Subdomain, auf die das Admin-Panel beschränkt wird.
ADMIN_HOST=

# --- Interne Endpunkte --------------------------------------------------------
# Bearer-Secret für die Cron-Routen. Ist es nicht gesetzt, bleiben sie offen.
CRON_SECRET=
# Key der Browser-Extension für /api/extension/add-bonus.
EXTENSION_API_KEY=
# Token der OBS-Chat-Aufzeichnung (?recorder=<token>). In Vercel als "sensitive".
RECORDER_TOKEN=
# Key für /api/control/* — Stream-Deck-Buttons und alles andere ohne Browser.
# Bewusst getrennt vom EXTENSION_API_KEY, damit einer rotiert werden kann,
# ohne den anderen mitzureißen.
CONTROL_API_KEY=

# --- Externe APIs -------------------------------------------------------------
# bonushunt.gg, Bearer-Auth (lib/bonushunt-api.ts).
API_KEY_Bonushuntgg=

# Wager-Leaderboard, GET mit Header x-api-key.
# Nur serverseitig lesen — kein NEXT_PUBLIC_-Präfix.
LEADERBOARD_API_URL=
LEADERBOARD_API_KEY=
